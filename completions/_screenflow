#compdef screenflow

_screenflow() {
  local device='iphone-17-pro'

  # Detect which --device value has been typed so far
  for ((i = 2; i < ${#words[@]}; i++)); do
    if [[ ${words[$i]} == --device=* ]]; then
      device=${words[$i]#--device=}
      break
    elif [[ ${words[$i]} == '--device' && -n ${words[$((i+1))]} ]]; then
      device=${words[$((i+1))]}
      break
    fi
  done

  # Colors per device — add a new case block when a new device is added
  local -a colors
  case $device in
    iphone-17-pro)
      colors=('silver:Silver (default)' 'deep-blue:Deep Blue' 'cosmic-orange:Cosmic Orange')
      ;;
    ipad-pro-11)
      colors=('silver:Silver' 'silver-with-apple-pencil:Silver with Apple Pencil' 'space-gray:Space Gray' 'space-gray-with-apple-pencil:Space Gray with Apple Pencil')
      ;;
    ipad-pro-13)
      colors=('silver:Silver' 'space-gray:Space Gray')
      ;;
    iphone-13-pro)
      colors=('sierra-blue:Sierra Blue')
      ;;
    iphone-14-pro)
      colors=('deep-purple:Deep Purple')
      ;;
    iphone-15-pro)
      colors=('titanium-nature:Desert Titanium')
      ;;
    iphone-16-pro)
      colors=('dessert-titanium:Desert Titanium' 'black:Black' 'natural:Natural' 'white:White')
      ;;
    iphone-air)
      colors=('black:Black' 'blue:Blue' 'gold:Gold' 'white:White')
      ;;
    iphone-17)
      colors=('black:Black' 'lavender:Lavender' 'mist-blue:Mist Blue' 'sage:Sage' 'white:White')
      ;;
    iphone-16)
      colors=('black:Black' 'pink:Pink' 'teal:Teal' 'ultramarine:Ultramarine' 'white:White')
      ;;
    imac)
      colors=('blue:Blue' 'green:Green' 'orange:Orange' 'pink:Pink' 'purple:Purple' 'silver:Silver' 'yellow:Yellow')
      ;;
    *)
      colors=('silver:Silver (default)')
      ;;
  esac

  local -a devices
  devices=(
    'iphone-17-pro:iPhone 17 Pro (default)'
    'ipad-pro-11:iPad Pro 11'
    'ipad-pro-13:iPad Pro 13'
    'iphone-13-pro:iPhone 13 Pro'
    'iphone-14-pro:iPhone 14 Pro'
    'iphone-15-pro:iPhone 15 Pro'
    'iphone-16-pro:iPhone 16 Pro'
  )

  _arguments \
    '(-v --version)'{-v,--version}'[output the version number]' \
    '(-h --help)'{-h,--help}'[display help]' \
    '--author[about the author]' \
    '(-o --output)'{-o+,--output=}'[output file path]:output file:_files' \
    '--png[output as PNG instead of SVG]' \
    '--jpeg[output as JPEG instead of SVG]' \
    '--video[create a 5-second zoom-in video animation (requires ffmpeg)]' \
    '--devices[list all devices and their available colors]' \
    '--set-default[save --device and/or --color as your personal defaults]' \
    '--show-config[show your saved defaults]' \
    '--device=[device frame]:device:->devices' \
    '--color=[frame color]:color:->colors' \
    ':screenshot:_files -g "*.png *.jpg *.jpeg"'

  case $state in
    devices) _describe 'device' devices ;;
    colors)  _describe 'color'  colors  ;;
  esac
}

_screenflow "$@"
