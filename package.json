{
  "name": "screenflow",
  "version": "0.2.52",
  "description": "CLI tool to create beautiful mockup device screenshots",
  "homepage": "https://github.com/marvinhuelsmann/screenflow",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marvinhuelsmann/screenflow.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "main": "dist/index.js",
  "bin": {
    "screenflow": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && cp -r src/frames/iphone-17-pro dist/frames/ && cp -r src/frames/ipad-pro-11 dist/frames/ && cp -r src/frames/ipad-pro-13 dist/frames/ && cp -r src/frames/iphone-13-pro dist/frames/",
    "prepare": "npm run build",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "add-device": "node scripts/add-device.js"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.4.3",
    "commander": "^12.0.0",
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  }
}
