{
  "name": "screenflow",
  "version": "0.1.0",
  "description": "CLI tool to create beautiful simulator screenshots",
  "homepage": "https://github.com/marvinhuelsmann/screenflow",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marvinhuelsmann/screenflow.git"
